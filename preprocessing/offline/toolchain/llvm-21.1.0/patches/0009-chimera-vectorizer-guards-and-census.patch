 #include "llvm/Support/KnownBits.h"
@@ -94,6 +95,7 @@
 #include <algorithm>
 #include <cassert>
 #include <cstdint>
+#include <cstdlib>
 #include <iterator>
 #include <memory>
 #include <optional>
@@ -20852,6 +20854,33 @@ void BoUpSLP::computeMinimumValueSizes() {
 }
 
 PreservedAnalyses SLPVectorizerPass::run(Function &F, FunctionAnalysisManager &AM) {
+  // Chimera auto-vectorization census: one line per function per run; formed
+  // is a function-level 0/1 (whether this run rewrote anything in the
+  // function) so it does not depend on LLVM statistics, which release builds
+  // compile out.  Gated functions early-out before any attempt and record
+  // formed=0; the gated flag carries the attribution.
+  const bool ChimeraGated = F.hasFnAttribute("chimera-no-vectorize");
+  bool ChimeraChanged = false;
+  struct ChimeraVecCensus {
+    Function &F;
+    bool Gated;
+    const bool *Changed;
+    ~ChimeraVecCensus() {
+      const char *StatsPath = std::getenv("CHIMERA_GATE_STATS");
+      if (!StatsPath)
+        return;
+      std::error_code EC;
+      raw_fd_ostream StatsOS(StatsPath, EC, sys::fs::OF_Append);
+      if (EC)
+        return;
+      const uint64_t Formed =
+          (!Gated && Changed && *Changed) ? uint64_t(1) : uint64_t(0);
+      StatsOS << "vectorizer-census\t" << F.getName() << "\tSLP\t" << Formed
+              << "\t" << (Gated ? 1 : 0) << "\n";
+    }
+  } ChimeraVecCensusGuard{F, ChimeraGated, &ChimeraChanged};
+  if (ChimeraGated)
+    return PreservedAnalyses::all();
   auto *SE = &AM.getResult<ScalarEvolutionAnalysis>(F);
   auto *TTI = &AM.getResult<TargetIRAnalysis>(F);
   auto *TLI = AM.getCachedResult<TargetLibraryAnalysis>(F);
@@ -20863,6 +20892,7 @@ PreservedAnalyses SLPVectorizerPass::run(Function &F, FunctionAnalysisManager &A
   auto *ORE = &AM.getResult<OptimizationRemarkEmitterAnalysis>(F);
 
   bool Changed = runImpl(F, SE, TTI, TLI, AA, LI, DT, AC, DB, ORE);
+  ChimeraChanged = Changed;
   if (!Changed)
     return PreservedAnalyses::all();
 
diff --git a/llvm/test/Transforms/Inline/chimera-no-inline-gate.ll b/llvm/test/Transforms/Inline/chimera-no-inline-gate.ll
new file mode 100644
index 000000000..e31d655b8
--- /dev/null
+++ b/llvm/test/Transforms/Inline/chimera-no-inline-gate.ll
@@ -0,0 +1,54 @@
+; RUN: opt -passes="always-inline" -S < %s | FileCheck %s
+;
+; A gated callee must not inline into an open caller.  All other directions
+; are allowed so a gated caller keeps the discovery build's function shape.
+
+; CHECK-LABEL: define void @open_to_gated(
+; CHECK: call void @gated_callee()
+; CHECK: ret void
+; CHECK-LABEL: define void @gated_to_open(
+; CHECK-NOT: call void @open_callee()
+; CHECK: ret void
+; CHECK-LABEL: define void @gated_to_gated(
+; CHECK-NOT: call void @gated_callee()
+; CHECK: ret void
+; CHECK-LABEL: define void @open_to_open(
+; CHECK-NOT: call void @open_callee()
+; CHECK: ret void
+define internal void @gated_callee() #0 {
+entry:
+  ret void
+}
+
+define internal void @open_callee() #1 {
+entry:
+  ret void
+}
+
+define void @open_to_gated() {
+entry:
+  call void @gated_callee()
+  ret void
+}
+
+define void @gated_to_open() #2 {
+entry:
+  call void @open_callee()
+  ret void
+}
+
+define void @gated_to_gated() #2 {
+entry:
+  call void @gated_callee()
+  ret void
+}
+
+define void @open_to_open() {
+entry:
+  call void @open_callee()
+  ret void
+}
+
+attributes #0 = { alwaysinline "chimera-no-vectorize" }
+attributes #1 = { alwaysinline }
+attributes #2 = { "chimera-no-vectorize" }
diff --git a/llvm/test/Transforms/LoopVectorize/chimera-no-vectorize-gate.ll b/llvm/test/Transforms/LoopVectorize/chimera-no-vectorize-gate.ll
new file mode 100644
index 000000000..a0a97dfa8
--- /dev/null
+++ b/llvm/test/Transforms/LoopVectorize/chimera-no-vectorize-gate.ll
@@ -0,0 +1,48 @@
+; RUN: opt -passes="default<O2>" -S < %s | FileCheck %s
+;
+; Chimera gate: the function carrying "chimera-no-vectorize" must keep its
+; trivially-vectorizable loop scalar (the patched LoopVectorize/SLPVectorizer
+; early-out), while the identical non-gated function is vectorized as usual.
+
+target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:32:32-p278:32:32-i64:64-i128:128-i512:512-f80:128-n8:16:32:64-S128"
+target triple = "x86_64-unknown-linux-gnu"
+
+; CHECK-LABEL: define void @gated(
+; CHECK-NOT: vector.body
+; CHECK: ret void
+define void @gated(ptr nocapture %p, i64 %n) #0 {
+entry:
+  br label %loop
+loop:
+  %i = phi i64 [ 0, %entry ], [ %next, %loop ]
+  %gep = getelementptr i32, ptr %p, i64 %i
+  %v = load i32, ptr %gep, align 4
+  %s = add nsw i32 %v, 1
+  store i32 %s, ptr %gep, align 4
+  %next = add nuw i64 %i, 1
+  %c = icmp slt i64 %next, %n
+  br i1 %c, label %loop, label %exit
+exit:
+  ret void
+}
+
+; CHECK-LABEL: define void @open(
+; CHECK: vector.body
+; CHECK: ret void
+define void @open(ptr nocapture %p, i64 %n) {
+entry:
+  br label %loop
+loop:
+  %i = phi i64 [ 0, %entry ], [ %next, %loop ]
+  %gep = getelementptr i32, ptr %p, i64 %i
+  %v = load i32, ptr %gep, align 4
+  %s = add nsw i32 %v, 1
+  store i32 %s, ptr %gep, align 4
+  %next = add nuw i64 %i, 1
+  %c = icmp slt i64 %next, %n
+  br i1 %c, label %loop, label %exit
+exit:
+  ret void
+}
+
+attributes #0 = { "chimera-no-vectorize" }
