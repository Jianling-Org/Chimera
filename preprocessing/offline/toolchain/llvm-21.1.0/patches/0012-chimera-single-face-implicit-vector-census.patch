 llvm/lib/CodeGen/SelectionDAG/DAGCombiner.cpp      |  69 ++++------
 llvm/lib/Target/RISCV/RISCVISelLowering.cpp        |  30 ++---
 llvm/lib/Transforms/Vectorize/LoopVectorize.cpp     |  52 +++-----
 llvm/lib/Transforms/Vectorize/SLPVectorizer.cpp     |  56 ++++-----
 5 files changed, 217 insertions(+), 125 deletions(-)
 create mode 100644 llvm/include/llvm/IR/ChimeraImplicitVectorCensus.h

diff --git a/llvm/include/llvm/IR/ChimeraImplicitVectorCensus.h b/llvm/include/llvm/IR/ChimeraImplicitVectorCensus.h
new file mode 100644
index 000000000..75516f3c3
--- /dev/null
+++ b/llvm/include/llvm/IR/ChimeraImplicitVectorCensus.h
@@ -0,0 +1,140 @@
+//===- ChimeraImplicitVectorCensus.h --------------------------*- C++ -*-===//
+//
+// Header-only support shared by IR vectorizers and code generation.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_IR_CHIMERAIMPLICITVECTORCENSUS_H
+#define LLVM_IR_CHIMERAIMPLICITVECTORCENSUS_H
+
+#include "llvm/ADT/SmallString.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/IR/Attributes.h"
+#include "llvm/IR/Function.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <cstdlib>
+#include <string>
+
+namespace llvm {
+
+inline constexpr StringLiteral kChimeraNoVectorizeAttr =
+    "chimera-no-vectorize";
+inline constexpr StringLiteral kChimeraCensusFunctionIdAttr =
+    "chimera-census-function-id";
+
+enum class ChimeraImplicitVectorMechanism { LV, SLP, MEMOP, MERGE };
+
+inline StringRef
+chimeraImplicitVectorMechanismName(ChimeraImplicitVectorMechanism M) {
+  switch (M) {
+  case ChimeraImplicitVectorMechanism::LV:
+    return "LV";
+  case ChimeraImplicitVectorMechanism::SLP:
+    return "SLP";
+  case ChimeraImplicitVectorMechanism::MEMOP:
+    return "MEMOP";
+  case ChimeraImplicitVectorMechanism::MERGE:
+    return "MERGE";
+  }
+  llvm_unreachable("unknown Chimera implicit-vector mechanism");
+}
+
+inline void chimeraReplaceAll(std::string &Value, StringRef From,
+                              StringRef To) {
+  for (std::string::size_type Pos = Value.find(From.str());
+       Pos != std::string::npos; Pos = Value.find(From.str(), Pos + To.size()))
+    Value.replace(Pos, From.size(), To.str());
+}
+
+inline std::string chimeraCanonicalFunctionName(StringRef Name) {
+  std::string Result = Name.str();
+  // The constructor/destructor discriminator is followed by arbitrary
+  // parameter encodings, not only the empty-parameter ``E`` terminator.
+  chimeraReplaceAll(Result, "C1", "C2");
+  chimeraReplaceAll(Result, "D1", "D2");
+  return Result;
+}
+
+inline bool chimeraImplicitVectorCensusEnabled() {
+  const char *Path = std::getenv("CHIMERA_GATE_STATS");
+  return Path && *Path;
+}
+
+inline void chimeraAppendImplicitVectorCensus(
+    ChimeraImplicitVectorMechanism Mechanism, StringRef FunctionId,
+    StringRef Action) {
+  const char *Path = std::getenv("CHIMERA_GATE_STATS");
+  if (!Path || !*Path)
+    return;
+  if (Action != "formed" && Action != "blocked")
+    report_fatal_error("invalid Chimera implicit-vector census action");
+  if (FunctionId.empty())
+    report_fatal_error("empty Chimera implicit-vector census function id");
+
+  SmallString<256> Line;
+  raw_svector_ostream LineOS(Line);
+  LineOS << "implicit-vector-census\t"
+         << chimeraImplicitVectorMechanismName(Mechanism) << "\t"
+         << chimeraCanonicalFunctionName(FunctionId) << "\t" << Action
+         << "\n";
+  std::error_code EC;
+  raw_fd_ostream StatsOS(Path, EC, sys::fs::OF_Append);
+  if (EC)
+    report_fatal_error(StringRef("cannot append Chimera implicit-vector census: " +
+                                 EC.message()));
+  StatsOS << Line;
+}
+
+inline bool chimeraRecordImplicitVectorDecision(
+    const Function &F, ChimeraImplicitVectorMechanism Mechanism) {
+  const bool Gated = F.hasFnAttribute(kChimeraNoVectorizeAttr);
+  chimeraAppendImplicitVectorCensus(Mechanism, F.getName(),
+                                    Gated ? "blocked" : "formed");
+  return Gated;
+}
+
+inline std::string
+chimeraCensusFunctionId(const AttributeList &FunctionAttributes) {
+  Attribute Id =
+      FunctionAttributes.getFnAttr(kChimeraCensusFunctionIdAttr);
+  if (!Id.isValid()) {
+    if (chimeraImplicitVectorCensusEnabled())
+      report_fatal_error("missing chimera census function id");
+    return {};
+  }
+  return chimeraCanonicalFunctionName(Id.getValueAsString());
+}
+
+inline bool chimeraRecordImplicitVectorDecision(
+    const AttributeList &FunctionAttributes,
+    ChimeraImplicitVectorMechanism Mechanism) {
+  const bool Gated =
+      FunctionAttributes.hasFnAttr(kChimeraNoVectorizeAttr);
+  if (chimeraImplicitVectorCensusEnabled())
+    chimeraAppendImplicitVectorCensus(
+        Mechanism, chimeraCensusFunctionId(FunctionAttributes),
+        Gated ? "blocked" : "formed");
+  return Gated;
+}
+
+inline void chimeraAssertImplicitVectorCommitAllowed(
+    const Function &F, ChimeraImplicitVectorMechanism Mechanism) {
+  if (F.hasFnAttribute(kChimeraNoVectorizeAttr))
+    report_fatal_error("gated function reached implicit-vector commit for " +
+                       chimeraImplicitVectorMechanismName(Mechanism));
+}
+
+inline void chimeraAssertImplicitVectorCommitAllowed(
+    const AttributeList &FunctionAttributes,
+    ChimeraImplicitVectorMechanism Mechanism) {
+  if (FunctionAttributes.hasFnAttr(kChimeraNoVectorizeAttr))
+    report_fatal_error("gated function reached implicit-vector commit for " +
+                       chimeraImplicitVectorMechanismName(Mechanism));
+}
+
+} // namespace llvm
+
+#endif // LLVM_IR_CHIMERAIMPLICITVECTORCENSUS_H
