   OS << '\n' << (char)0;  // null terminate string.
 }
 
+static unsigned getInlineAsmPCSectionLocator(const MDNode &MD) {
+  std::optional<unsigned> Locator;
+  unsigned I = 0;
+  while (I < MD.getNumOperands()) {
+    auto *Section = dyn_cast<MDString>(MD.getOperand(I).get());
+    if (!Section)
+      report_fatal_error("malformed PCSections metadata");
+
+    StringRef Name = Section->getString();
+    size_t OptStart = Name.find('!');
+    bool HasLocator = false;
+    if (OptStart != StringRef::npos) {
+      StringRef Opts = Name.substr(OptStart + 1);
+      HasLocator = Opts.contains('L');
+    }
+
+    ++I;
+
+    const MDNode *Aux = nullptr;
+    if (I < MD.getNumOperands() && isa<MDNode>(MD.getOperand(I).get())) {
+      Aux = cast<MDNode>(MD.getOperand(I).get());
+      ++I;
+    }
+
+    if (!HasLocator)
+      continue;
+
+    // Current L semantics allow exactly one internal inline-asm location per
+    // MachineInstr.
+    if (Locator)
+      report_fatal_error("multiple PCSections L entries "
+                         "on one inline-asm instruction");
+
+    if (!Aux || Aux->getNumOperands() == 0)
+      report_fatal_error("PCSections option L requires "
+                         "an inline-asm locator");
+
+    auto *CAM = dyn_cast<ConstantAsMetadata>(Aux->getOperand(0));
+    if (!CAM)
+      report_fatal_error("PCSections inline-asm locator must be a constant");
+
+    auto *CI = dyn_cast<ConstantInt>(CAM->getValue());
+    if (!CI || !CI->getType()->isIntegerTy(32))
+      report_fatal_error("PCSections inline-asm locator must be i32");
+
+    Locator = static_cast<unsigned>(CI->getZExtValue());
+  }
+
+  if (!Locator)
+    report_fatal_error("missing PCSections inline-asm locator");
+
+  return *Locator;
+}
+
+static std::optional<size_t>
+findInlineAsmInstructionOffset(StringRef Asm, const MCAsmInfo &MAI,
+                               unsigned TargetIndex) {
+  const StringRef Separator = MAI.getSeparatorString();
+  const StringRef Comment = MAI.getCommentString();
+
+  unsigned InstructionIndex = 0;
+  size_t StatementStart = 0;
+
+  auto ProcessStatement = [&](size_t StatementEnd) -> std::optional<size_t> {
+    if (StatementEnd < StatementStart)
+      return std::nullopt;
+
+    StringRef Statement = Asm.slice(StatementStart, StatementEnd);
+    StringRef Trimmed = Statement.trim();
+    if (Trimmed.empty())
+      return std::nullopt;
+
+    // Labels are not actual instructions.
+    //
+    // This matches the locator semantics used by Chimera's inline-asm
+    // analysis.
+    if (Trimmed.ends_with(":"))
+      return std::nullopt;
+
+    // Relevant Chimera inline asm only permits .option directives. They do not
+    // count toward the instruction index.
+    if (Trimmed.starts_with(".option"))
+      return std::nullopt;
+
+    if (InstructionIndex == TargetIndex)
+      return StatementStart;
+
+    ++InstructionIndex;
+    return std::nullopt;
+  };
+
+  size_t Pos = 0;
+
+  // EmitInlineAsmStr() null terminates StringData. Do not inspect the
+  // terminating NUL as asm text.
+  while (Pos < Asm.size() && Asm[Pos] != '\0') {
+    // A comment consumes the remainder of the line.
+    //
+    // First process any instruction preceding the comment.
+    if (!Comment.empty() && Asm.substr(Pos).starts_with(Comment)) {
+      if (auto Offset = ProcessStatement(Pos))
+        return Offset;
+
+      size_t Newline = Asm.find('\n', Pos);
+      if (Newline == StringRef::npos)
+        return std::nullopt;
+
+      Pos = Newline + 1;
+      StatementStart = Pos;
+      continue;
+    }
+
+    if (Asm[Pos] == '\n') {
+      if (auto Offset = ProcessStatement(Pos))
+        return Offset;
+
+      ++Pos;
+      StatementStart = Pos;
+      continue;
+    }
+
+    if (!Separator.empty() && Asm.substr(Pos).starts_with(Separator)) {
+      if (auto Offset = ProcessStatement(Pos))
+        return Offset;
+
+      Pos += Separator.size();
+      StatementStart = Pos;
+      continue;
+    }
+
+    ++Pos;
+  }
+
+  if (auto Offset = ProcessStatement(Pos))
+    return Offset;
+
+  return std::nullopt;
+}
+
 /// This method formats and emits the specified machine instruction that is an
 /// inline asm.
 void AsmPrinter::emitInlineAsm(const MachineInstr *MI) const {
@@ -361,6 +500,45 @@ void AsmPrinter::emitInlineAsm(const MachineInstr *MI) const {
   AsmPrinter *AP = const_cast<AsmPrinter*>(this);
   EmitInlineAsmStr(AsmStr, MI, MMI, MAI, AP, LocCookie, OS);
 
+  const MDNode *InlinePCSectionMD = nullptr;
+  SmallString<64> InlinePCSectionLabelName;
+
+  if (const MDNode *PCMD = MI->getPCSections();
+      PCMD && hasPCSectionOption(*PCMD, 'L')) {
+    const unsigned TargetIndex = getInlineAsmPCSectionLocator(*PCMD);
+
+    std::optional<size_t> Offset = findInlineAsmInstructionOffset(
+        StringRef(StringData.data(), StringData.size()), *MAI, TargetIndex);
+
+    if (!Offset)
+      report_fatal_error("PCSections inline-asm locator "
+                         "does not identify an instruction");
+
+    MDNode *LocatorMD = filterPCSectionsByOption(*PCMD, 'L',
+                                                 /*KeepMatching=*/true);
+    if (!LocatorMD)
+      report_fatal_error("failed to extract PCSections L metadata");
+
+    InlinePCSectionMD = LocatorMD;
+
+    // Do not create an MCSymbol yet.
+    //
+    // Let the inline-asm parser create and define the symbol from the textual
+    // label.
+    {
+      raw_svector_ostream NameOS(InlinePCSectionLabelName);
+      NameOS << MAI->getPrivateGlobalPrefix() << "chimera_pcsection_"
+             << getFunctionNumber() << "_" << InlineAsmPCSectionLabelCounter++;
+    }
+
+    SmallString<96> LabelText;
+    raw_svector_ostream LabelOS(LabelText);
+    LabelOS << '\n' << InlinePCSectionLabelName << MAI->getLabelSuffix()
+            << '\n';
+
+    StringData.insert(StringData.begin() + *Offset, LabelText.begin(),
+                      LabelText.end());
+  }
   // Emit warnings if we use reserved registers on the clobber list, as
   // that might lead to undefined behaviour.
   SmallVector<Register, 8> RestrRegs;
@@ -412,6 +590,21 @@ void AsmPrinter::emitInlineAsm(const MachineInstr *MI) const {
   emitInlineAsm(StringData, getSubtargetInfo(), TM.Options.MCOptions, LocMD,
                 MI->getInlineAsmDialect());
 
+  // The integrated assembler has now parsed the injected label.
+  //
+  // Look the symbol up only after parsing, so the returned MCSymbol is the
+  // exact symbol defined by the parser.
+  if (InlinePCSectionMD) {
+    MCSymbol *Symbol =
+        OutContext.getOrCreateSymbol(InlinePCSectionLabelName.str());
+
+    if (!Symbol->isDefined())
+      report_fatal_error("inline-asm PCSections label "
+                         "was not defined by assembler");
+
+    AP->recordPCSectionsLabel(*InlinePCSectionMD, Symbol);
+  }
+
   // Emit the #NOAPP end marker.  This has to happen even if verbose-asm isn't
   // enabled, so we use emitRawComment.
   OutStreamer->emitRawComment(MAI->getInlineAsmEnd());
diff --git a/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.cpp b/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.cpp
index 4954e23..36251a2 100644
--- a/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.cpp
+++ b/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.cpp
@@ -10363,6 +10363,18 @@ void SelectionDAGBuilder::visitInlineAsm(const CallBase &Call,
   unsigned ISDOpc = IsCallBr ? ISD::INLINEASM_BR : ISD::INLINEASM;
   Chain = DAG.getNode(ISDOpc, getCurSDLoc(),
                       DAG.getVTList(MVT::Other, MVT::Glue), AsmNodeOperands);
+
+  // Chimera deferred PCSections.
+  //
+  // Generic !pcsections propagation in SelectionDAGBuilder::visit() relies on
+  // NodeMap. A void inline-asm call has no SSA result, therefore it may not
+  // have a NodeMap entry corresponding to the actual ISD::INLINEASM node.
+  //
+  // Attach deferred Chimera PCSections metadata here, where the exact
+  // INLINEASM / INLINEASM_BR SDNode is known.
+  if (MDNode *MD = Call.getMetadata("chimera.pcsections"))
+    DAG.addPCSections(Chain.getNode(), MD);
+
   Glue = Chain.getValue(1);
 
   // Do additional work to generate outputs.
diff --git a/llvm/test/CodeGen/RISCV/chimera-pcsections-inline-asm.ll b/llvm/test/CodeGen/RISCV/chimera-pcsections-inline-asm.ll
new file mode 100644
index 0000000..caead67
--- /dev/null
+++ b/llvm/test/CodeGen/RISCV/chimera-pcsections-inline-asm.ll
@@ -0,0 +1,26 @@
+; RUN: llc -mtriple=riscv64 -mattr=+v -filetype=asm < %s | FileCheck %s
+
+; A void inline-asm call has no useful NodeMap result. The deferred metadata
+; must be transferred by visitInlineAsm() to the exact INLINEASM SDNode. The
+; !L locator places the label at instruction 1 and is omitted from payload.
+
+define void @inline_locator(ptr %p) {
+entry:
+  call void asm sideeffect
+      "addi t0, $0, 16\0A\09vle8.v v8, (t0)",
+      "r"(ptr %p), !chimera.pcsections !0
+  ret void
+}
+
+; CHECK-LABEL: inline_locator:
+; CHECK: #APP
+; CHECK: addi t0,
+; CHECK: .Lchimera_pcsection_{{[0-9]+}}_{{[0-9]+}}:
+; CHECK-NEXT: vle8.v v8, (t0)
+; CHECK: .section .chimera.stackobj_map
+; CHECK: .quad .Lchimera_pcsection_{{[0-9]+}}_{{[0-9]+}}
+; CHECK-NOT: .word 1
+; CHECK-NEXT: .word 23
+
+!0 = distinct !{!".chimera.stackobj_map!AL", !1}
+!1 = !{i32 1, i32 23}
