+bool AsmPrinter::hasPCSectionOption(const MDNode &MD, char Option) const {
+  unsigned I = 0;
+  while (I < MD.getNumOperands()) {
+    auto *Section = dyn_cast<MDString>(MD.getOperand(I).get());
+    if (!Section)
+      report_fatal_error("malformed PCSections metadata");
+
+    StringRef Name = Section->getString();
+    size_t OptStart = Name.find('!');
+    if (OptStart != StringRef::npos) {
+      StringRef Opts = Name.substr(OptStart + 1);
+      if (Opts.contains(Option))
+        return true;
+    }
+
+    ++I;
+    // Optional auxiliary tuple belonging to this section.
+    if (I < MD.getNumOperands() && isa<MDNode>(MD.getOperand(I).get()))
+      ++I;
+  }
+
+  return false;
+}
+
+MDNode *AsmPrinter::filterPCSectionsByOption(const MDNode &MD, char Option,
+                                             bool KeepMatching) const {
+  SmallVector<Metadata *, 8> Ops;
+  unsigned I = 0;
+  while (I < MD.getNumOperands()) {
+    auto *Section = dyn_cast<MDString>(MD.getOperand(I).get());
+    if (!Section)
+      report_fatal_error("malformed PCSections metadata");
+
+    StringRef Name = Section->getString();
+    size_t OptStart = Name.find('!');
+    bool HasOption = false;
+    if (OptStart != StringRef::npos) {
+      StringRef Opts = Name.substr(OptStart + 1);
+      HasOption = Opts.contains(Option);
+    }
+
+    Metadata *Aux = nullptr;
+    ++I;
+    if (I < MD.getNumOperands() && isa<MDNode>(MD.getOperand(I).get())) {
+      Aux = MD.getOperand(I).get();
+      ++I;
+    }
+
+    if (HasOption != KeepMatching)
+      continue;
+
+    Ops.push_back(Section);
+    if (Aux)
+      Ops.push_back(Aux);
+  }
+
+  if (Ops.empty())
+    return nullptr;
+
+  // Keep the top-level PCSections node distinct. Different instruction
+  // locations must not accidentally share the same metadata identity in
+  // PCSectionsSymbols.
+  return MDNode::getDistinct(MD.getContext(), Ops);
+}
+
+void AsmPrinter::recordPCSectionsLabel(const MDNode &MD,
+                                       const MCSymbol *Symbol) {
+  PCSectionsSymbols[&MD].emplace_back(Symbol);
+}
