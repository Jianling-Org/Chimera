diff --git a/llvm/test/CodeGen/RISCV/chimera-rvv-spill-rv32.ll b/llvm/test/CodeGen/RISCV/chimera-rvv-spill-rv32.ll
new file mode 100644
index 0000000..80c0aa1
--- /dev/null
+++ b/llvm/test/CodeGen/RISCV/chimera-rvv-spill-rv32.ll
@@ -0,0 +1,23 @@
+; RUN: not --crash llc -mtriple=riscv32 -mattr=+v < %s -o /dev/null 2>&1 | FileCheck %s
+
+; Chimera's backend carrier has a fixed RV64 wire contract. Creating backend
+; StackObject metadata on RV32 must fail explicitly rather than emit bad data.
+
+declare void @clobber()
+declare <vscale x 1 x i32> @llvm.riscv.vle.nxv1i32(
+    <vscale x 1 x i32>, ptr, i32)
+declare void @llvm.riscv.vse.nxv1i32(
+    <vscale x 1 x i32>, ptr, i32)
+
+define void @reject_rv32(ptr %in, ptr %out, i32 %vl) #0 {
+  %v = call <vscale x 1 x i32> @llvm.riscv.vle.nxv1i32(
+      <vscale x 1 x i32> poison, ptr %in, i32 %vl)
+  call void @clobber()
+  call void @llvm.riscv.vse.nxv1i32(
+      <vscale x 1 x i32> %v, ptr %out, i32 %vl)
+  ret void
+}
+
+; CHECK: LLVM ERROR: Chimera backend StackObject map requires XLEN=64
+
+attributes #0 = { "chimera-stack-object" }
diff --git a/llvm/test/CodeGen/RISCV/chimera-rvv-spill-stock-rv32.ll b/llvm/test/CodeGen/RISCV/chimera-rvv-spill-stock-rv32.ll
new file mode 100644
index 0000000..6d25501
--- /dev/null
+++ b/llvm/test/CodeGen/RISCV/chimera-rvv-spill-stock-rv32.ll
@@ -0,0 +1,29 @@
+; RUN: llc -mtriple=riscv32 -mattr=+v -stop-after=prologepilog < %s \
+; RUN:   | FileCheck %s
+; RUN: llc -mtriple=riscv32 -mattr=+v -stop-after=prologepilog < %s \
+; RUN:   | not grep -E 'pcsections|chimera\.stackobj_map'
+; RUN: llc -mtriple=riscv32 -mattr=+v -filetype=asm < %s \
+; RUN:   | not grep -E '\.Lpcsection|\.chimera\.stackobj_map'
+
+; A stock RV32 function has no Chimera opt-in attribute. RVV spill/reload must
+; codegen normally and must not reach Chimera's RV64-only diagnostic or emit
+; any Chimera PCSections data.
+
+; CHECK-LABEL: name: stock_spill_rv32
+; CHECK: VS1R_V
+; CHECK: VL1RE8_V
+
+declare void @clobber()
+declare <vscale x 1 x i32> @llvm.riscv.vle.nxv1i32(
+    <vscale x 1 x i32>, ptr, i32)
+declare void @llvm.riscv.vse.nxv1i32(
+    <vscale x 1 x i32>, ptr, i32)
+
+define void @stock_spill_rv32(ptr %in, ptr %out, i32 %vl) {
+  %v = call <vscale x 1 x i32> @llvm.riscv.vle.nxv1i32(
+      <vscale x 1 x i32> poison, ptr %in, i32 %vl)
+  call void @clobber()
+  call void @llvm.riscv.vse.nxv1i32(
+      <vscale x 1 x i32> %v, ptr %out, i32 %vl)
+  ret void
+}
diff --git a/llvm/test/CodeGen/RISCV/chimera-rvv-spill-stock-rv64.ll b/llvm/test/CodeGen/RISCV/chimera-rvv-spill-stock-rv64.ll
