diff --git a/llvm/test/CodeGen/RISCV/chimera-rvv-spill.ll b/llvm/test/CodeGen/RISCV/chimera-rvv-spill.ll
new file mode 100644
index 0000000..77541cc
--- /dev/null
+++ b/llvm/test/CodeGen/RISCV/chimera-rvv-spill.ll
@@ -0,0 +1,95 @@
+; RUN: llc -mtriple=riscv64 -mattr=+v -stop-after=prologepilog < %s | FileCheck %s
+; RUN: llc -mtriple=riscv64 -mattr=+v -stop-after=prologepilog < %s \
+; RUN:   | not grep -E 'PseudoV(L|S)E.*pcsections'
+
+; Values live over a call force ordinary RVV spill/reload creation. Preserve
+; the four register classes verified by the original RISC-V experiment.
+
+declare void @clobber()
+
+declare <vscale x 1 x i64> @llvm.riscv.vle.nxv1i64(
+    <vscale x 1 x i64>, ptr, i64)
+declare void @llvm.riscv.vse.nxv1i64(
+    <vscale x 1 x i64>, ptr, i64)
+
+declare <vscale x 2 x i64> @llvm.riscv.vle.nxv2i64(
+    <vscale x 2 x i64>, ptr, i64)
+declare void @llvm.riscv.vse.nxv2i64(
+    <vscale x 2 x i64>, ptr, i64)
+
+declare <vscale x 4 x i64> @llvm.riscv.vle.nxv4i64(
+    <vscale x 4 x i64>, ptr, i64)
+declare void @llvm.riscv.vse.nxv4i64(
+    <vscale x 4 x i64>, ptr, i64)
+
+declare <vscale x 8 x i64> @llvm.riscv.vle.nxv8i64(
+    <vscale x 8 x i64>, ptr, i64)
+declare void @llvm.riscv.vse.nxv8i64(
+    <vscale x 8 x i64>, ptr, i64)
+
+define void @spill_vr(ptr %in, ptr %out, i64 %vl) #0 {
+  %in.next = getelementptr i8, ptr %in, i64 64
+  %out.next = getelementptr i8, ptr %out, i64 64
+  %v0 = call <vscale x 1 x i64> @llvm.riscv.vle.nxv1i64(
+      <vscale x 1 x i64> poison, ptr %in, i64 %vl)
+  %v1 = call <vscale x 1 x i64> @llvm.riscv.vle.nxv1i64(
+      <vscale x 1 x i64> poison, ptr %in.next, i64 %vl)
+  call void @clobber()
+  call void @llvm.riscv.vse.nxv1i64(
+      <vscale x 1 x i64> %v0, ptr %out, i64 %vl)
+  call void @llvm.riscv.vse.nxv1i64(
+      <vscale x 1 x i64> %v1, ptr %out.next, i64 %vl)
+  ret void
+}
+
+define void @spill_vrm2(ptr %in, ptr %out, i64 %vl) #0 {
+  %v = call <vscale x 2 x i64> @llvm.riscv.vle.nxv2i64(
+      <vscale x 2 x i64> poison, ptr %in, i64 %vl)
+  call void @clobber()
+  call void @llvm.riscv.vse.nxv2i64(
+      <vscale x 2 x i64> %v, ptr %out, i64 %vl)
+  ret void
+}
+
+define void @spill_vrm4(ptr %in, ptr %out, i64 %vl) #0 {
+  %v = call <vscale x 4 x i64> @llvm.riscv.vle.nxv4i64(
+      <vscale x 4 x i64> poison, ptr %in, i64 %vl)
+  call void @clobber()
+  call void @llvm.riscv.vse.nxv4i64(
+      <vscale x 4 x i64> %v, ptr %out, i64 %vl)
+  ret void
+}
+
+define void @spill_vrm8(ptr %in, ptr %out, i64 %vl) #0 {
+  %v = call <vscale x 8 x i64> @llvm.riscv.vle.nxv8i64(
+      <vscale x 8 x i64> poison, ptr %in, i64 %vl)
+  call void @clobber()
+  call void @llvm.riscv.vse.nxv8i64(
+      <vscale x 8 x i64> %v, ptr %out, i64 %vl)
+  ret void
+}
+
+; The source/destination vle/vse are unrelated RVV memory operations and do
+; not receive Chimera metadata. Only compiler-created spills and reloads do.
+; MIR prints PCSections as an opaque pointer. Do not treat that address as a
+; stable identity; payload and final-map correctness are checked at ELF level.
+
+; CHECK-LABEL: name: spill_vr
+; CHECK: PseudoVLE{{.*}}
+; CHECK-COUNT-2: VS1R_V {{.*}}pcsections <
+; CHECK-COUNT-2: VL1RE8_V {{.*}}pcsections <
+; CHECK: PseudoVSE{{.*}}
+
+; CHECK-LABEL: name: spill_vrm2
+; CHECK: VS2R_V {{.*}}pcsections <
+; CHECK: VL2RE8_V {{.*}}pcsections <
+
+; CHECK-LABEL: name: spill_vrm4
+; CHECK: VS4R_V {{.*}}pcsections <
+; CHECK: VL4RE8_V {{.*}}pcsections <
+
+; CHECK-LABEL: name: spill_vrm8
+; CHECK: VS8R_V {{.*}}pcsections <
+; CHECK: VL8RE8_V {{.*}}pcsections <
+
+attributes #0 = { "chimera-stack-object" }
