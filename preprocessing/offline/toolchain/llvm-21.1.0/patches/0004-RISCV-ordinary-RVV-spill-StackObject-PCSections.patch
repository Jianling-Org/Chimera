+++ b/llvm/lib/Target/RISCV/RISCVInstrInfo.cpp
@@ -9,7 +9,9 @@
 // This file contains the RISC-V implementation of the TargetInstrInfo class.
 //
 //===----------------------------------------------------------------------===//
-
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/MDBuilder.h"
 #include "RISCVInstrInfo.h"
 #include "MCTargetDesc/RISCVBaseInfo.h"
 #include "MCTargetDesc/RISCVMatInt.h"
@@ -50,6 +52,59 @@ STATISTIC(NumVRegSpilled,
 STATISTIC(NumVRegReloaded,
           "Number of registers within vector register groups reloaded");
 
+namespace {
+
+constexpr uint32_t ChimeraBackendSOIDBase = 0x80000000u;
+constexpr uint32_t ChimeraInvalidSOID = 0xffffffffu;
+
+static bool hasChimeraStackObject(const MachineFunction &MF) {
+  return MF.getFunction().hasFnAttribute("chimera-stack-object");
+}
+
+static MDNode *createChimeraStackObjectPCSections(MachineFunction &MF,
+                                                  int FrameIndex) {
+  if (MF.getSubtarget<RISCVSubtarget>().getXLen() != 64)
+    report_fatal_error("Chimera backend StackObject map requires XLEN=64");
+
+  // Compiler-created spill objects use the upper half of the StackObjectID
+  // space:
+  //
+  //   SOID = 0x80000000 | FrameIndex
+  //
+  // 0xffffffff remains reserved as invalid.
+  if (FrameIndex < 0 ||
+      static_cast<uint64_t>(FrameIndex) >= 0x7fffffffu)
+    report_fatal_error("Chimera backend StackObjectID overflow");
+
+  const uint32_t SOID =
+      ChimeraBackendSOIDBase | static_cast<uint32_t>(FrameIndex);
+  if (SOID == ChimeraInvalidSOID)
+    report_fatal_error("invalid Chimera backend StackObjectID");
+
+  LLVMContext &Ctx = MF.getFunction().getContext();
+  Constant *SOIDConstant = ConstantInt::get(Type::getInt32Ty(Ctx), SOID);
+
+  SmallVector<Constant *, 1> Aux;
+  Aux.push_back(SOIDConstant);
+
+  SmallVector<MDBuilder::PCSection, 1> Sections;
+  Sections.push_back({".chimera.stackobj_map!A", std::move(Aux)});
+
+  MDBuilder MDB(Ctx);
+  MDNode *MD = MDB.createPCSections(Sections);
+
+  // PCSectionsSymbols is keyed by MDNode*. Identical metadata on two
+  // MachineInstrs must not be uniqued into one node, otherwise multiple PCs
+  // could share one auxiliary SOID.
+  SmallVector<Metadata *, 4> Ops;
+  for (const MDOperand &Op : MD->operands())
+    Ops.push_back(Op.get());
+
+  return MDNode::getDistinct(Ctx, Ops);
+}
+
+} // namespace
+
 static cl::opt<bool> PreferWholeRegisterMove(
     "riscv-prefer-whole-register-move", cl::init(false), cl::Hidden,
     cl::desc("Prefer whole register move for vector registers."));
