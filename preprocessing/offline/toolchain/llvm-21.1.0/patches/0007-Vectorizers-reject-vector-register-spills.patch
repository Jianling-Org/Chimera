diff --git a/llvm/test/Transforms/LoopVectorize/RISCV/spill-cost.ll b/llvm/test/Transforms/LoopVectorize/RISCV/spill-cost.ll
new file mode 100644
index 0000000..cb768e5
--- /dev/null
+++ b/llvm/test/Transforms/LoopVectorize/RISCV/spill-cost.ll
@@ -0,0 +1,108 @@
+; RUN: opt -mtriple=riscv64 -mattr=+v -passes=loop-vectorize \
+; RUN:   -force-vector-interleave=1 \
+; RUN:   -scalable-vectorization=on -force-target-supports-scalable-vectors \
+; RUN:   -S < %s | FileCheck %s --check-prefix=OFF
+; RUN: opt -mtriple=riscv64 -mattr=+v -passes=loop-vectorize \
+; RUN:   -force-vector-interleave=1 \
+; RUN:   -scalable-vectorization=on -force-target-supports-scalable-vectors \
+; RUN:   -spill-cost -S < %s | FileCheck %s --check-prefix=ON
+; RUN: opt -mtriple=riscv64 -mattr=+v -passes=loop-vectorize \
+; RUN:   -force-vector-interleave=1 \
+; RUN:   -scalable-vectorization=on -force-target-supports-scalable-vectors \
+; RUN:   -spill-cost -debug-only=loop-vectorize -disable-output < %s 2>&1 \
+; RUN:   | FileCheck %s --check-prefix=REJECT
+; REQUIRES: asserts
+
+; @pressure needs ~34 vector registers, two more than RISC-V's 32. OFF keeps
+; LLVM's prior choice of VF under that pressure; ON rejects the same candidate
+; because -spill-cost gates vector register pressure. The GPR-only case cannot
+; be expressed stably through a VPlan, so it is covered by a unit test instead
+; (llvm/unittests/Transforms/Vectorize/VPlanAnalysisTest.cpp).
+
+define void @pressure(
+    ptr noalias %a0, ptr noalias %a1, ptr noalias %a2,
+    ptr noalias %a3, ptr noalias %a4, ptr noalias %a5,
+    ptr noalias %a6, ptr noalias %a7, ptr noalias %a8,
+    ptr noalias %a9, ptr noalias %a10, ptr noalias %a11,
+    ptr noalias %a12, ptr noalias %a13, ptr noalias %a14,
+    ptr noalias %a15, ptr noalias %a16, ptr noalias %out, i64 %n) {
+entry:
+  br label %loop
+
+loop:
+  %iv = phi i64 [ 0, %entry ], [ %next, %loop ]
+  %p0 = getelementptr float, ptr %a0, i64 %iv
+  %p1 = getelementptr float, ptr %a1, i64 %iv
+  %p2 = getelementptr float, ptr %a2, i64 %iv
+  %p3 = getelementptr float, ptr %a3, i64 %iv
+  %p4 = getelementptr float, ptr %a4, i64 %iv
+  %p5 = getelementptr float, ptr %a5, i64 %iv
+  %p6 = getelementptr float, ptr %a6, i64 %iv
+  %p7 = getelementptr float, ptr %a7, i64 %iv
+  %p8 = getelementptr float, ptr %a8, i64 %iv
+  %p9 = getelementptr float, ptr %a9, i64 %iv
+  %p10 = getelementptr float, ptr %a10, i64 %iv
+  %p11 = getelementptr float, ptr %a11, i64 %iv
+  %p12 = getelementptr float, ptr %a12, i64 %iv
+  %p13 = getelementptr float, ptr %a13, i64 %iv
+  %p14 = getelementptr float, ptr %a14, i64 %iv
+  %p15 = getelementptr float, ptr %a15, i64 %iv
+  %p16 = getelementptr float, ptr %a16, i64 %iv
+  %x0 = load float, ptr %p0, align 4
+  %x1 = load float, ptr %p1, align 4
+  %x2 = load float, ptr %p2, align 4
+  %x3 = load float, ptr %p3, align 4
+  %x4 = load float, ptr %p4, align 4
+  %x5 = load float, ptr %p5, align 4
+  %x6 = load float, ptr %p6, align 4
+  %x7 = load float, ptr %p7, align 4
+  %x8 = load float, ptr %p8, align 4
+  %x9 = load float, ptr %p9, align 4
+  %x10 = load float, ptr %p10, align 4
+  %x11 = load float, ptr %p11, align 4
+  %x12 = load float, ptr %p12, align 4
+  %x13 = load float, ptr %p13, align 4
+  %x14 = load float, ptr %p14, align 4
+  %x15 = load float, ptr %p15, align 4
+  %x16 = load float, ptr %p16, align 4
+  %s0 = fadd float %x1, %x2
+  %s1 = fadd float %x3, %x4
+  %s2 = fadd float %x5, %x6
+  %s3 = fadd float %x7, %x8
+  %s4 = fadd float %x9, %x10
+  %s5 = fadd float %x11, %x12
+  %s6 = fadd float %x13, %x14
+  %s7 = fadd float %x15, %x16
+  %s8 = fadd float %x0, %s0
+  %s9 = fadd float %s1, %s2
+  %s10 = fadd float %s3, %s4
+  %s11 = fadd float %s5, %s6
+  %s12 = fadd float %s8, %s9
+  %s13 = fadd float %s10, %s11
+  %s14 = fadd float %s12, %s13
+  %sum = fadd float %s14, %s7
+  %q = getelementptr float, ptr %out, i64 %iv
+  store float %sum, ptr %q, align 4
+  %next = add nuw i64 %iv, 1
+  %done = icmp eq i64 %next, %n
+  br i1 %done, label %exit, label %loop, !llvm.loop !0
+
+exit:
+  ret void
+}
+
+; OFF-LABEL: define void @pressure(
+; OFF-NOT: <vscale x 2 x float>
+; OFF: <vscale x 4 x float>
+; OFF-NOT: <vscale x 2 x float>
+;
+; ON-LABEL: define void @pressure(
+; ON-NOT: <vscale x 4 x float>
+; ON: <vscale x 2 x float>
+; ON-NOT: <vscale x 4 x float>
+;
+; REJECT: Not considering vector loop of width vscale x 4 because it is expected to spill vector registers
+
+!0 = distinct !{!0, !1, !2}
+!1 = !{!"llvm.loop.vectorize.enable", i1 true}
+!2 = !{!"llvm.loop.vectorize.scalable.enable", i1 true}
diff --git a/llvm/test/Transforms/SLPVectorizer/spill-cost.ll b/llvm/test/Transforms/SLPVectorizer/spill-cost.ll
new file mode 100644
index 0000000..7949cd4
--- /dev/null
+++ b/llvm/test/Transforms/SLPVectorizer/spill-cost.ll
@@ -0,0 +1,62 @@
+; RUN: opt -mtriple=riscv64 -mattr=+v -passes=slp-vectorizer \
+; RUN:   -slp-threshold=-100 -S < %s | FileCheck %s --check-prefix=OFF
+; RUN: opt -mtriple=riscv64 -mattr=+v -passes=slp-vectorizer \
+; RUN:   -slp-threshold=-100 -spill-cost -S < %s \
+; RUN:   | FileCheck %s --check-prefix=ON
+; RUN: opt -mtriple=riscv64 -mattr=+v -passes=slp-vectorizer \
+; RUN:   -slp-threshold=-100 -spill-cost -debug-only=SLP -disable-output \
+; RUN:   < %s 2>&1 | FileCheck %s --check-prefix=DEBUG
+; REQUIRES: asserts
+
+declare void @clobber()
+
+define void @positive_spill(ptr noalias %src, ptr noalias %dst) {
+  %s1 = getelementptr float, ptr %src, i64 1
+  %s2 = getelementptr float, ptr %src, i64 2
+  %s3 = getelementptr float, ptr %src, i64 3
+  %d1 = getelementptr float, ptr %dst, i64 1
+  %d2 = getelementptr float, ptr %dst, i64 2
+  %d3 = getelementptr float, ptr %dst, i64 3
+  %v0 = load float, ptr %src, align 4
+  %v1 = load float, ptr %s1, align 4
+  %v2 = load float, ptr %s2, align 4
+  %v3 = load float, ptr %s3, align 4
+  call void @clobber()
+  store float %v0, ptr %dst, align 4
+  store float %v1, ptr %d1, align 4
+  store float %v2, ptr %d2, align 4
+  store float %v3, ptr %d3, align 4
+  ret void
+}
+
+define void @zero_spill(ptr noalias %src, ptr noalias %dst) {
+  %s1 = getelementptr float, ptr %src, i64 1
+  %s2 = getelementptr float, ptr %src, i64 2
+  %s3 = getelementptr float, ptr %src, i64 3
+  %d1 = getelementptr float, ptr %dst, i64 1
+  %d2 = getelementptr float, ptr %dst, i64 2
+  %d3 = getelementptr float, ptr %dst, i64 3
+  %v0 = load float, ptr %src, align 4
+  %v1 = load float, ptr %s1, align 4
+  %v2 = load float, ptr %s2, align 4
+  %v3 = load float, ptr %s3, align 4
+  store float %v0, ptr %dst, align 4
+  store float %v1, ptr %d1, align 4
+  store float %v2, ptr %d2, align 4
+  store float %v3, ptr %d3, align 4
+  ret void
+}
+
+; OFF-LABEL: @positive_spill(
+; OFF: load <4 x float>
+; OFF: store <4 x float>
+; ON-LABEL: @positive_spill(
+; ON-NOT: load <4 x float>
+; ON: call void @clobber()
+; ON-LABEL: @zero_spill(
+; ON: load <4 x float>
+; ON: store <4 x float>
+
+; DEBUG: SLP: Rejecting vectorization because it is expected to spill vector registers
+; DEBUG: SLP: Spill Cost = {{[1-9][0-9]*}}
+; DEBUG: SLP: Spill Cost = 0
