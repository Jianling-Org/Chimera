diff --git a/llvm/lib/Transforms/Vectorize/LoopVectorize.cpp b/llvm/lib/Transforms/Vectorize/LoopVectorize.cpp
index 5cf4b16..5b54828 100644
--- a/llvm/lib/Transforms/Vectorize/LoopVectorize.cpp
+++ b/llvm/lib/Transforms/Vectorize/LoopVectorize.cpp
@@ -52,7 +52,7 @@
 //  Vectorizing Compilers.
 //
 //===----------------------------------------------------------------------===//
-
+#include "VectorizeOptions.h"
 #include "llvm/Transforms/Vectorize/LoopVectorize.h"
 #include "LoopVectorizationPlanner.h"
 #include "VPRecipeBuilder.h"
@@ -4254,9 +4254,15 @@ VectorizationFactor LoopVectorizationPlanner::selectVectorizationFactor() {
                                P->vectorFactors().end());
 
     SmallVector<VPRegisterUsage, 8> RUs;
-    if (CM.useMaxBandwidth(TargetTransformInfo::RGK_ScalableVector) ||
-        CM.useMaxBandwidth(TargetTransformInfo::RGK_FixedWidthVector))
-      RUs = calculateRegisterUsageForPlan(*P, VFs, TTI, CM.ValuesToIgnore);
+
+    const bool CheckRegisterPressure =
+        EnableSpillCost ||
+        CM.useMaxBandwidth(TargetTransformInfo::RGK_ScalableVector) ||
+        CM.useMaxBandwidth(TargetTransformInfo::RGK_FixedWidthVector);
+
+    if (CheckRegisterPressure)
+      RUs =
+          calculateRegisterUsageForPlan(*P, VFs, TTI, CM.ValuesToIgnore);
 
     for (unsigned I = 0; I < VFs.size(); I++) {
       ElementCount VF = VFs[I];
@@ -4269,6 +4275,14 @@ VectorizationFactor LoopVectorizationPlanner::selectVectorizationFactor() {
       if (CM.useMaxBandwidth(VF) && RUs[I].exceedsMaxNumRegs(TTI))
         continue;
 
+      if (EnableSpillCost && RUs[I].exceedsMaxNumVectorRegs(TTI)) {
+        LLVM_DEBUG(dbgs() << "LV(REG): Not considering vector loop of width "
+                          << VF
+                          << " because it is expected to spill vector "
+                             "registers\n");
+        continue;
+      }
+
       InstructionCost C = CM.expectedCost(VF);
 
       // Add on other costs that are modelled in VPlan, but not in the legacy
@@ -7021,9 +7035,15 @@ VectorizationFactor LoopVectorizationPlanner::computeBestVF() {
                                P->vectorFactors().end());
 
     SmallVector<VPRegisterUsage, 8> RUs;
-    if (CM.useMaxBandwidth(TargetTransformInfo::RGK_ScalableVector) ||
-        CM.useMaxBandwidth(TargetTransformInfo::RGK_FixedWidthVector))
-      RUs = calculateRegisterUsageForPlan(*P, VFs, TTI, CM.ValuesToIgnore);
+
+    const bool CheckRegisterPressure =
+        EnableSpillCost ||
+        CM.useMaxBandwidth(TargetTransformInfo::RGK_ScalableVector) ||
+        CM.useMaxBandwidth(TargetTransformInfo::RGK_FixedWidthVector);
+
+    if (CheckRegisterPressure)
+      RUs =
+          calculateRegisterUsageForPlan(*P, VFs, TTI, CM.ValuesToIgnore);
 
     for (unsigned I = 0; I < VFs.size(); I++) {
       ElementCount VF = VFs[I];
@@ -7054,6 +7074,14 @@ VectorizationFactor LoopVectorizationPlanner::computeBestVF() {
         continue;
       }
 
+      if (EnableSpillCost && RUs[I].exceedsMaxNumVectorRegs(TTI)) {
+        LLVM_DEBUG(dbgs() << "LV(REG): Not considering vector loop of width "
+                          << VF
+                          << " because it is expected to spill vector "
+                             "registers\n");
+        continue;
+      }
+
       if (isMoreProfitable(CurrentFactor, BestFactor, P->hasScalarTail()))
         BestFactor = CurrentFactor;
 
diff --git a/llvm/lib/Transforms/Vectorize/SLPVectorizer.cpp b/llvm/lib/Transforms/Vectorize/SLPVectorizer.cpp
index f6610ea..8b1a3d9 100644
--- a/llvm/lib/Transforms/Vectorize/SLPVectorizer.cpp
+++ b/llvm/lib/Transforms/Vectorize/SLPVectorizer.cpp
@@ -15,7 +15,7 @@
 //  "Loop-Aware SLP in GCC" by Ira Rosen, Dorit Nuzman, Ayal Zaks.
 //
 //===----------------------------------------------------------------------===//
-
+#include "VectorizeOptions.h"
 #include "llvm/Transforms/Vectorize/SLPVectorizer.h"
 #include "llvm/ADT/DenseMap.h"
 #include "llvm/ADT/DenseSet.h"
@@ -15085,7 +15085,14 @@ InstructionCost BoUpSLP::getTreeCost(ArrayRef<Value *> VectorizedVals,
   std::optional<InstructionCost> SpillCost;
   if (Cost < -SLPCostThreshold) {
     SpillCost = getSpillCost();
-    Cost += *SpillCost;
+
+    if (EnableSpillCost && *SpillCost > 0) {
+      LLVM_DEBUG(dbgs() << "SLP: Rejecting vectorization because it is "
+                         "expected to spill vector registers\n");
+      Cost = InstructionCost::getMax();
+    } else {
+      Cost += *SpillCost;
+    }
   }
 #ifndef NDEBUG
   SmallString<256> Str;
diff --git a/llvm/lib/Transforms/Vectorize/VPlanAnalysis.cpp b/llvm/lib/Transforms/Vectorize/VPlanAnalysis.cpp
index 66657b9..428a9f5 100644
--- a/llvm/lib/Transforms/Vectorize/VPlanAnalysis.cpp
+++ b/llvm/lib/Transforms/Vectorize/VPlanAnalysis.cpp
@@ -411,6 +411,14 @@ bool VPRegisterUsage::exceedsMaxNumRegs(const TargetTransformInfo &TTI) const {
   });
 }
 
+bool VPRegisterUsage::exceedsMaxNumVectorRegs(
+    const TargetTransformInfo &TTI) const {
+  return any_of(MaxLocalUsers, [this, &TTI](auto &LU) {
+    return VectorRegisterClasses.contains(LU.first) &&
+           LU.second > TTI.getNumberOfRegisters(LU.first);
+  });
+}
+
 SmallVector<VPRegisterUsage, 8> llvm::calculateRegisterUsageForPlan(
     VPlan &Plan, ArrayRef<ElementCount> VFs, const TargetTransformInfo &TTI,
     const SmallPtrSetImpl<const Value *> &ValuesToIgnore) {
@@ -491,6 +499,7 @@ SmallVector<VPRegisterUsage, 8> llvm::calculateRegisterUsageForPlan(
   SmallPtrSet<VPRecipeBase *, 8> OpenIntervals;
   SmallVector<VPRegisterUsage, 8> RUs(VFs.size());
   SmallVector<SmallMapVector<unsigned, unsigned, 4>, 8> MaxUsages(VFs.size());
+  SmallVector<SmallDenseSet<unsigned, 4>, 8> VectorRegisterClasses(VFs.size());
 
   LLVM_DEBUG(dbgs() << "LV(REG): Calculating max register usage:\n");
 
@@ -576,6 +585,7 @@ SmallVector<VPRegisterUsage, 8> llvm::calculateRegisterUsageForPlan(
           for (VPValue *DefV : R->definedValues()) {
             Type *ScalarTy = TypeInfo.inferScalarType(DefV);
             unsigned ClassID = TTI.getRegisterClassForType(true, ScalarTy);
+            VectorRegisterClasses[J].insert(ClassID);
             RegUsage[ClassID] += GetRegUsage(ScalarTy, VF);
           }
         }
@@ -615,6 +625,8 @@ SmallVector<VPRegisterUsage, 8> llvm::calculateRegisterUsageForPlan(
       ElementCount VF = IsScalar ? ElementCount::getFixed(1) : VFs[Idx];
       unsigned ClassID = TTI.getRegisterClassForType(
           VF.isVector(), TypeInfo.inferScalarType(In));
+      if (VF.isVector())
+        VectorRegisterClasses[Idx].insert(ClassID);
       Invariant[ClassID] += GetRegUsage(TypeInfo.inferScalarType(In), VF);
     }
 
@@ -638,6 +650,7 @@ SmallVector<VPRegisterUsage, 8> llvm::calculateRegisterUsageForPlan(
 
     RU.LoopInvariantRegs = Invariant;
     RU.MaxLocalUsers = MaxUsages[Idx];
+    RU.VectorRegisterClasses = VectorRegisterClasses[Idx];
     RUs[Idx] = RU;
   }
 
diff --git a/llvm/lib/Transforms/Vectorize/VPlanAnalysis.h b/llvm/lib/Transforms/Vectorize/VPlanAnalysis.h
index 7bcf9db..941f542 100644
--- a/llvm/lib/Transforms/Vectorize/VPlanAnalysis.h
+++ b/llvm/lib/Transforms/Vectorize/VPlanAnalysis.h
@@ -80,13 +80,21 @@ struct VPRegisterUsage {
   /// Holds the number of loop invariant values that are used in the loop.
   /// The key is ClassID of target-provided register class.
   SmallMapVector<unsigned, unsigned, 4> LoopInvariantRegs;
+
   /// Holds the maximum number of concurrent live intervals in the loop.
   /// The key is ClassID of target-provided register class.
   SmallMapVector<unsigned, unsigned, 4> MaxLocalUsers;
 
+  /// Register classes used for vector values.
+  SmallDenseSet<unsigned, 4> VectorRegisterClasses;
+
   /// Check if any of the tracked live intervals exceeds the number of
   /// available registers for the target.
   bool exceedsMaxNumRegs(const TargetTransformInfo &TTI) const;
+
+  /// Check if any vector register class exceeds the number of available
+  /// registers for the target.
+  bool exceedsMaxNumVectorRegs(const TargetTransformInfo &TTI) const;
 };
 
