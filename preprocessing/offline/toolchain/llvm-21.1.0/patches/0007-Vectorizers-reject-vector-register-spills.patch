diff --git a/llvm/unittests/Transforms/Vectorize/VPlanAnalysisTest.cpp b/llvm/unittests/Transforms/Vectorize/VPlanAnalysisTest.cpp
new file mode 100644
index 0000000..9221118
--- /dev/null
+++ b/llvm/unittests/Transforms/Vectorize/VPlanAnalysisTest.cpp
@@ -0,0 +1,54 @@
+//===- VPlanAnalysisTest.cpp - Tests for VPlan register usage analysis ----===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "../lib/Transforms/Vectorize/VPlanAnalysis.h"
+#include "llvm/Analysis/TargetTransformInfo.h"
+#include "llvm/IR/DataLayout.h"
+#include "gtest/gtest.h"
+
+using namespace llvm;
+
+namespace {
+
+// Generic baseline-TTI register class IDs: scalar = 0, vector = 1.
+constexpr unsigned ScalarClass = 0;
+constexpr unsigned VectorClass = 1;
+
+// VPRegisterUsage::exceedsMaxNumVectorRegs must only reject candidates whose
+// vector register class pressure exceeds the target's register count. A scalar
+// (GPR) class that exceeds its own limit must not trigger the gate, which is
+// what distinguishes this check from exceedsMaxNumRegs().
+
+TEST(VPRegisterUsageTest, OnlyVectorClassesTriggerTheGate) {
+  // The baseline TTI reports 8 registers for every class.
+  DataLayout DL("e-p:64:64");
+  TargetTransformInfo TTI(DL);
+
+  VPRegisterUsage RU;
+
+  // A vector class over the limit is rejected.
+  RU.MaxLocalUsers[VectorClass] = 9;
+  RU.VectorRegisterClasses.insert(VectorClass);
+  EXPECT_TRUE(RU.exceedsMaxNumVectorRegs(TTI));
+
+  // A scalar class over the limit is ignored because it is not recorded as a
+  // vector class.
+  RU.MaxLocalUsers.clear();
+  RU.MaxLocalUsers[ScalarClass] = 9;
+  RU.VectorRegisterClasses.clear();
+  EXPECT_FALSE(RU.exceedsMaxNumVectorRegs(TTI));
+
+  // A vector class within its limit is not rejected, even when a scalar class
+  // is over its own limit at the same time.
+  RU.MaxLocalUsers[VectorClass] = 8;
+  RU.MaxLocalUsers[ScalarClass] = 9;
+  RU.VectorRegisterClasses.insert(VectorClass);
+  EXPECT_FALSE(RU.exceedsMaxNumVectorRegs(TTI));
+}
+
+} // namespace
