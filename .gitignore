# Build and release output (repository-local; user resources live in ~/.chimera)
/build/
/dist/
*.egg-info/

# Python bytecode, test/type-check caches and coverage output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
/htmlcov/

# Local virtual environments
/.venv/
/venv/

# Native build output (subdirectory rules may opt in tracked fixtures)
*.so
*.so.*
*.o
*.a
*.obj
*.dll
*.dylib
*.exe

# Generated diagnostics; do not ignore arbitrary JSON, TXT or HTML files
*.log
*.check.json
*.dis

# Local editor/agent state and scratch checkout
/.vscode/
/.idea/
/.devshim/
/.qoder/
/.workbuddy/
/.zcode/
/CONTEXT.md
/llamacpp-source/
/.superpowers/
superpowers/
gcc-k3-2026/
project-context/

# Machine-local filesystem metadata
.DS_Store
Thumbs.db

# External runtime inputs and local acceptance evidence
/examples/applications/llama-cpp/model/*.gguf
/runtime/bpf/trigger/vmlinux.h
/workspaces/
/reports/
/tmp/

# Generated legacy export and local agent state
/release/
/.codex/
/.agents/
