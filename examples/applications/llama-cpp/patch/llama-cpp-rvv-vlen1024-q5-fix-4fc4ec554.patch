+static inline int8_t ggml_q3_K_scale_scalar(const block_q3_K * x, int idx) {
+    const int group = idx >> 2;
+    const int off   = idx & 3;
+    const int lo    = (group & 1) ? 4 + off : off;
+
+    int scale = x->scales[lo];
+    if (group >= 2) {
+        scale >>= 4;
+    } else {
+        scale &= 0x0f;
+    }
+
+    const int scale_hi = (x->scales[8 + off] >> (group * 2)) & 0x03;
+    scale |= scale_hi << 4;
+
+    return (int8_t) scale - 32;
+}
+
+static inline int8_t ggml_q3_K_weight_scalar(const block_q3_K * x, int elem) {
+    const int phase    = elem / 128;
+    const int rem      = elem % 128;
+    const int qgrp     = rem / 32;
+    const int hm_idx   = rem % 32;
+    const int qs_idx   = phase * 32 + hm_idx;
+    const int qs_shift = qgrp * 2;
+    const int hm_shift = phase * 4 + qgrp;
+
+    int weight = (x->qs[qs_idx] >> qs_shift) & 0x03;
+    if (((x->hmask[hm_idx] >> hm_shift) & 0x01) == 0) {
+        weight -= 4;
+    }
+
+    return (int8_t) weight;
+}
