+				READ_ONCE(p->thread_type) !=
+					(hmp_cpu_is_ai(target_cpu) ? HMP_REGULAR : HMP_AI) ||
+				(p->flags & (PF_EXITING | PF_KTHREAD)))
+				continue;
+			if (cursor && skipped < *cursor) {
+				skipped++;
+				continue;
+			}
+			get_task_struct(p);
+			tasks[count++] = p;
+			if (count == limit)
