+struct send_signal_work {
+	struct work_struct work;
+
+	int cpu;
+	pid_t pid;
+	u64 payload;
+	unsigned long pc;
+};
+
+static void send_signal_workfn(struct work_struct *work)
+{
+
+	struct send_signal_work *sw;
+	struct task_struct *task;
+	struct kernel_siginfo info;
+	int ret;
+	sw = container_of(work, struct send_signal_work, work);
+
+	chimera_info("send_signal_work: target_cpu=%d current_cpu=%d pid=%d payload=0x%llx pc=0x%lx\n",
+		sw->cpu, raw_smp_processor_id(), sw->pid,
+		sw->payload, sw->pc);
+
+	rcu_read_lock();
+	task = find_task_by_vpid(sw->pid);
+	if (task)
+		get_task_struct(task);
+	rcu_read_unlock();
+	if (!task)
+		goto out_free;
+	if (task->flags & PF_EXITING)
+		goto out_put;
+
+	struct my_data *data;
+
+	data = xa_load(&my_xa, task->pid);
+	if(data)
+	{
+		chimera_warn("[send_signal_workfn] xa_load data not empty pid %d\n",task->pid);
+		goto out_put;
+	}
+
+	unsigned long ip = task_pt_regs(task)->epc;
+	traget_migration_direction = true;
+
+	data = kzalloc(sizeof(*data), GFP_ATOMIC);
+	if (!data)
+	{
+		chimera_warn("[send_signal_workfn]  kzalloc !data\n");
+		goto out_put_task;
+	}
+
+	data->value = sw->cpu;
+	ret = xa_insert(&my_xa, task->pid, data, GFP_ATOMIC);
+	if (ret == -EBUSY)
+	{
+		chimera_warn("[send_signal_workfn]  xa_insert EBUSY\n");
+		kfree(data);
+		goto out_put_task;
+	}
+
+	clear_siginfo(&info);
+	info.si_signo = 41;
+	info.si_errno = 0;
+	info.si_code = SI_QUEUE;
+	info.si_value.sival_ptr = (void __user *)(uintptr_t)sw->payload;
+	if(task_pt_regs(task)->epc != sw->pc)
+	{
+		chimera_warn("task_pt_regs(task)->epc 0x%llx != sw->pc 0x%llx\n",
+			task_pt_regs(task)->epc, sw->pc);
+	}
+	ret = send_sig_info(41, &info, task);
+	chimera_info("send_sig_info pid=%d ret=%d cpu=%d\n",
+		sw->pid, ret, raw_smp_processor_id());
+
+out_put_task:
+out_put:
+	put_task_struct(task);
+
+out_free:
+
+kfree(sw);
+
+}
+
+static DECLARE_WORK(send_signal_work,
+		    send_signal_workfn);
+
 __bpf_kfunc_start_defs();
 
