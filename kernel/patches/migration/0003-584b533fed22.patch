+		goto out_put_task;
+	}
+
+	INIT_WORK(&sw->work, send_signal_workfn);
+	sw->cpu = dst_cpu;
+	sw->pid = pid;
+	sw->payload = 0;
+	unsigned long ip = 0;
+	sw->pc = ip;
+	if (!schedule_work_on(dst_cpu, &sw->work)) {
+		kfree(sw);
+		chimera_warn("schedule_work_on EBUSY\n");
+		goto out_put_task;
+	}
+	chimera_info("[bpf_xdp_get_xfrm_state_chimera] sucess pid %d: %d->%d ...\n", pid, src_cpu, dst_cpu);
+
+out_put_task:
+	put_task_struct(task);
+	return 0;
 }
 
