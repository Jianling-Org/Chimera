-	if(ci == NULL )
-		return pid;
+	chimera_info("[bpf_xdp_get_xfrm_state_chimera] match... current pid %d cpu %d task pid %d cpu %d  dst cpu %d \n"
+		, current->pid, task_cpu(current), task->pid, src_cpu, dst_cpu);
 
-	return (pid_t)ci->mimpid;
+
+	struct my_data *data;
